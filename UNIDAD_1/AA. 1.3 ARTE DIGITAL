function setup() {
  createCanvas(400, 400);
}

function draw() {
  background(255, 204, 0);

  //mesa
  noStroke();
  fill(255, 204, 204);
  ellipse(200,350,600,600); 

  //libros 

  fill(255, 255, 179); 
  rect(30,200,80,90);
  fill(204, 204, 0); //primer libro verde
  rect(35,200,80,90);

  fill(179, 179, 0);  //tapa de atras del segundo libro verde
  rect(95,145,80,90);

  fill(255, 255, 179); //tapa de en medio color blanco del libro verde
  rect(96,145,80,90);
  
  fill(179, 179, 0); //tapa verde del segundo libro 
  rect(100,150,80,90);

  fill(255, 255, 179); 
  rect(155,80,80,90);

  fill(179, 179, 0); //tapa verde de abajo del tercer libro
  rect(150,80,80,90);

  
  fill(255, 255, 179); //doble rectangulo blanco del tercer libro verde
  rect(150,180,80,90);

  fill(255, 255, 179);
  rect(155,185,80,90);

  fill(179, 179, 0); //tapa verde de arriba del tercer libro
  rect(155,185,80,90);

  fill(255, 255, 179); //tapa blanca del primer libro naranja 
  rect(252,252,80,90);

  fill(230, 138, 0); //tapa naranja del primer libro 
  rect(250,250,80,90);

  fill(255, 255, 179); //tapa blanca del segundo libro naranja 
  rect(260,200,80,90);

  fill(230, 138, 0); // tapa naranja del segundo libro 
  rect(258,198,80,90);

  fill(255, 255, 179); //tapa blanca del 3er libro horizontal naranja 
  rect(250,220,100,80);

  fill(204, 122, 0);   //tapa naranja del 3er libro
  rect(250,225,100,80);

  fill(255, 255, 179); 
  rect(250,80,90,80);

  fill(179, 179, 0); 
  rect(250,75,90,80);

  fill(255, 255, 179); 
  rect(30,90,90,80);

  fill(179, 179, 0); 
  rect(30,78,90,80);

  fill(255, 255, 179); 
  rect(20,300,90,80);

  fill(179, 179, 0); 
  rect(20,290,90,80);

  fill(255, 245, 230); //libro abierto
  rect(130,290,150,90);
  
  fill(255, 224, 179); //rectangulo naranjita que da profundidad
  rect(130,292,150,90);
  
  fill(255, 245, 230); //rectangulo blanco final 
  rect(130,294,150,90);

  //linea de en medio del libro
  stroke(128);         //color linea 
  strokeWeight(2);   // Grosor linea
  line(205, 294, 205, 384); 

}
